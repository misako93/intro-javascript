# ─────────────────────────────────────────────────────────────
#  Copiez ce fichier en .env.local puis remplissez les valeurs.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# (préfixe NEXT_PUBLIC_ obligatoire : ces 2 valeurs sont utilisées dans le navigateur,
#  elles sont publiques par nature, la sécurité est assurée par les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase → Project Settings → API → service_role (SECRÈTE : jamais côté navigateur)
# Utilisée uniquement par le webhook Stripe et l'envoi des notifications push.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# OpenAI → https://platform.openai.com/api-keys
# Obligatoire : transcription des vocaux (Whisper).
# Sert aussi de traducteur (gpt-4o-mini) si ANTHROPIC_API_KEY est vide.
OPENAI_API_KEY=sk-...

# Anthropic → https://console.anthropic.com/settings/keys
# Optionnel : si présent, Claude est utilisé pour la traduction (recommandé pour les dialectes arabes).
ANTHROPIC_API_KEY=sk-ant-...

# ── Abonnements (Stripe) ─────────────────────────────────────
# Laissez vide pour un usage 100 % gratuit (pas de paywall).
# Un seul abonné dans une conversation suffit : son interlocuteur n'a rien à payer.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Prix affiché dans l'app (doit correspondre au prix Stripe)
NEXT_PUBLIC_PRICE_LABEL=9,99 € / mois
# Messages offerts par conversation avant de devoir s'abonner
FREE_MESSAGES_PER_ROOM=20

# ── Notifications push (app mobile) ─────────────────────────
# Générez la paire de clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.com

# ── Réglages optionnels ──────────────────────────────────────
# Forcer le traducteur : "anthropic" ou "openai" (par défaut : anthropic si la clé existe)
TRANSLATION_PROVIDER=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Nom affiché de l'application
NEXT_PUBLIC_APP_NAME=Tarjem
# Afficher le bouton "Continuer avec Google" (activez d'abord Google dans Supabase → Auth → Providers)
NEXT_PUBLIC_GOOGLE_AUTH=false
