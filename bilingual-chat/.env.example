# ─────────────────────────────────────────────────────────────
#  Copiez ce fichier en .env.local puis remplissez les valeurs.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# (préfixe NEXT_PUBLIC_ obligatoire : ces 2 valeurs sont utilisées dans le navigateur,
#  elles sont publiques par nature, la sécurité est assurée par les règles RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase → Project Settings → API → service_role (SECRÈTE : jamais côté navigateur)
# Utilisée uniquement par le webhook Stripe et l'envoi des notifications push.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── IA : traduction + assistant (texte) ─────────────────────
# Option A — OpenAI directement (le plus simple : une seule clé pour le texte ET les vocaux)
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Option B — OpenRouter (un seul compte, des centaines de modèles au choix)
#   https://openrouter.ai/keys — décommentez ces 3 lignes et mettez la clé OpenRouter dans OPENAI_API_KEY
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_TRANSLATION_MODEL=openai/gpt-4o-mini
#   ⚠️ OpenRouter ne fait pas les vocaux → remplissez aussi la section "Vocaux" ci-dessous.

# Anthropic (Claude) — optionnel, prioritaire sur OpenAI/OpenRouter si présent
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── IA : vocaux (transcription Whisper) ──────────────────────
# Vide = utilise OPENAI_API_KEY (option A). Avec OpenRouter, choisissez :
#   OpenAI : TRANSCRIBE_API_KEY=sk-...            (0,006 $/min)
#   Groq   : TRANSCRIBE_API_KEY=gsk_...  + les 2 lignes suivantes (moins cher, très rapide)
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3
#   (whisper-large-v3 est plus juste que la version -turbo : testé sur un vocal réel)

# ── Abonnements (Stripe) ─────────────────────────────────────
# Laissez vide pour un usage 100 % gratuit (pas de paywall).
# Un seul abonné dans une conversation suffit : son interlocuteur n'a rien à payer.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Prix affiché dans l'app (doit correspondre au prix Stripe)
NEXT_PUBLIC_PRICE_LABEL=9,99 € / mois
# Messages offerts par conversation avant de devoir s'abonner
FREE_MESSAGES_PER_ROOM=20
# Mode hôtel : messages offerts à l'hôtel (tous clients confondus) avant abonnement
FREE_MESSAGES_PER_HOTEL=200

# ── Partenaires (apporteurs d'affaires) ─────────────────────
# Comptes bancaires et versements par Stripe Connect (Express) : activer Connect dans Stripe.
# Pays du compte Stripe de la plateforme (VTL Systems LLC = US).
STRIPE_PLATFORM_COUNTRY=US
# Secret de la tâche mensuelle qui verse les commissions :
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://VOTRE-DOMAINE/api/partners/payouts
CRON_SECRET=

# ── Notifications push (app mobile) ─────────────────────────
# Générez la paire de clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.com

# ── Réglages optionnels ──────────────────────────────────────
# Forcer le traducteur : "anthropic" ou "openai" (par défaut : anthropic si la clé existe)
TRANSLATION_PROVIDER=
ANTHROPIC_MODEL=claude-haiku-5-5

# Langue de l'écran du CLIENT de l'hôtel :
#   fr   → tout en français (pendant le développement)
#   auto → dans la langue du téléphone du client (26 langues prêtes) — à activer au lancement
# (la traduction des messages fonctionne dans les deux cas)
NEXT_PUBLIC_GUEST_UI_LANGUAGE=fr

# Nom affiché de l'application
NEXT_PUBLIC_APP_NAME=Tarjem
# Afficher le bouton "Continuer avec Google" (activez d'abord Google dans Supabase → Auth → Providers)
NEXT_PUBLIC_GOOGLE_AUTH=false
