# Clé API Claude (https://platform.claude.com) — obligatoire pour les vraies réponses.
# Sans clé, l'application tourne en « mode démo » avec des réponses simulées.
ANTHROPIC_API_KEY=

# Code d'accès demandé à l'ouverture de l'application (recommandé dès que l'URL est publique).
ACCESS_CODE=

# Optionnel — modèle et niveau d'effort (low = plus rapide, medium = plus poussé).
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Optionnel — mettre à 1 pour forcer le mode démo même si une clé est présente.
DEMO_MODE=
